# Port the server listens on
PORT=3000

# Public, externally-reachable base URL of THIS server.
# Must be reachable FROM the phone. When testing on a real device on your LAN,
# use your machine's LAN IP (e.g. http://192.168.1.50:3000), not localhost.
# In production use your HTTPS domain (e.g. https://updates.bellissimo.uz).
PUBLIC_URL=http://localhost:3000

# Bearer token protecting deploy/management/upload routes + the console.
# Generate one: openssl rand -hex 32
HOT_UPDATER_AUTH_TOKEN=change-me-to-a-long-random-secret

# Where the SQLite DB and uploaded bundles live (persist this in production).
DATA_DIR=./data
